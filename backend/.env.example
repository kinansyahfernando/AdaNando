# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN pernah membagikan file .env.

# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ---- Database (MySQL / MariaDB) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_utbk

# ---- Keamanan ----
# Wajib. Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h

# Pendaftaran mandiri siswa. Untuk sekolah: false (akun dibuat admin / impor CSV).
ALLOW_REGISTER=false

# Satu akun siswa hanya boleh aktif di satu perangkat (cegah berbagi akun / joki).
SINGLE_SESSION=true

# Akun dikunci sementara setelah salah password berkali-kali
MAX_FAILED_LOGINS=5
LOCK_MINUTES=10

# Admin pertama (hanya dipakai saat "npm run migrate" pertama kali).
# Kosongkan ADMIN_PASSWORD agar dibuatkan acak dan ditampilkan sekali di layar.
ADMIN_EMAIL=admin@sekolahmu.sch.id
ADMIN_PASSWORD=

# ---- Jaringan ----
# Isi 1 bila server berada di belakang Caddy / Nginx / Cloudflare (agar IP asli siswa tercatat)
TRUST_PROXY=
# Origin lain yang boleh memanggil API (pisahkan koma). Kosong = hanya satu alamat yang sama.
CORS_ORIGINS=

# ---- Aplikasi web siswa (Flutter Web / PWA) ----
# Folder hasil `flutter build web --release`. Bila diisi, server menyajikan aplikasi di "/".
# Contoh: ../frontend/build/web
WEB_DIR=
